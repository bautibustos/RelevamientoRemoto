# Copiar como .env. Si se dejan vacías, se usa la sesión actual de Windows.
WMI_USUARIO=
WMI_PASSWORD=

# Ruta de la base. Vacía = db/inventario.db. Puede ser una carpeta compartida:
# INVENTARIO_DB=\\SERVIDOR01.dominio.local\d$\inv\db\inventario.db
INVENTARIO_DB=

# normal = la API hace ping y releva por WMI (por defecto).
# carga  = la API solo guarda; releva el validador que corre dentro de la red.
MODO_API=normal

# 1 = la API corre también el validador (en la PC de adentro de la red).
VALIDADOR=0
# Segundos entre búsquedas de PCs pendientes.
VALIDADOR_INTERVALO=5
